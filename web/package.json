{
  "name": "web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "prebuild": "pnpm i18n:check",
    "postbuild": "node scripts/gen-offline-pack.ts",
    "audit:arabic": "node scripts/audit-arabic-digest.ts",
    "assert:headers": "bash scripts/assert-headers.sh",
    "preview": "vp preview",
    "start": "bun server.ts",
    "prepare": "svelte-kit sync || echo ''",
    "i18n:compile": "node scripts/compile-i18n.mjs",
    "i18n:namespaces": "node scripts/gen-message-namespaces.ts",
    "i18n:namespaces:check": "node scripts/gen-message-namespaces.ts --check",
    "i18n:check": "node scripts/check-i18n.mjs && pnpm i18n:compile && pnpm i18n:namespaces",
    "precheck": "pnpm i18n:check",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc -p tsconfig.worker.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "anti-slop:sync": "node scripts/sync-anti-slop.ts",
    "prelint": "pnpm anti-slop:sync && pnpm i18n:check",
    "lint": "vp lint --deny-warnings",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "pretest": "pnpm i18n:check",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/amiri": "^5.2.5",
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "@tanstack/hotkeys": "0.8.0",
    "@tanstack/svelte-form": "^1.33.5",
    "@tanstack/svelte-virtual": "^3.13.35",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "es-toolkit": "^1.50.0",
    "firebase": "^12.16.0",
    "simple-icons": "^16.28.0",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@fontsource/scheherazade-new": "^5.3.0",
    "@inlang/paraglide-js": "2.23.2",
    "@inlang/plugin-message-format": "4.4.1",
    "@internationalized/date": "^3.12.2",
    "@lucide/svelte": "^1.27.0",
    "@oxlint/plugins": "1.73.0",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^26.1.1",
    "@types/turndown": "^5.0.6",
    "happy-dom": "^20.11.1",
    "oxlint-plugin-anti-slop": "github:dmmulroy/anti-slop#9b80d9a5c317d3af94d88a577bdbde4d9a45f7be",
    "phosphor-svelte": "^3.1.0",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.0",
    "turndown": "^7.2.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "4.1.10"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.15.1",
      "onFail": "download"
    }
  }
}
