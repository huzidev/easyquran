# EasyQuran — example environment for local development.
# Single source for web + API + R2 uploads: `web/.env` and `rust/.env` are
# symlinks to this file (created by `just _env`), and `just` loads it
# automatically (dotenv-load). Edit HERE only.
#   Copy to start:  cp .env.example .env   (or run `just setup`).
#
# The default build runs on SQLite only — NO Postgres, NO Redis. Feature-gated
# providers (billing, FCM, WebAuthn, Cloudflare email, OAuth) are OFF by default;
# add their keys only if you enable the matching cargo feature.

# ── Runtime ─────────────────────────────────────────────────────────────────
HOST=0.0.0.0
# API port. MUST match the port embedded in PUBLIC_QURAN_API_BASE (below).
PORT=8888
# `development` lets the field-encryption key fall back to a non-secret dev
# default. Set to `production` in real deployments.
RUST_ENV=development
APP_ENV=development

# Web auth gate (W8f): mounts /auth/v1, /email_verification/v1,
# /forgot_password/v1, OAuth + passkey routes. Default OFF server-side — with it
# unset every auth call 404s and the web forms show a misleading
# "Email or password is incorrect." error. Dev boots fine with just this flag;
# production has extra boot gates — see deploy/.env.example.
WEB_AUTH_ENABLED=true

# Cookie-signing / keyed-hash secret. MUST be >= 32 bytes of CSPRNG output and
# must NOT be the placeholder below. Generate:  openssl rand -hex 32
COOKIE_KEY=CHANGE_ME_generate_with_openssl_rand_hex_32_______________________

# ── Database (SQLite — the only data store) ─────────────────────────────────
# `mode=rwc` creates the file on first boot; the data/ dir is ensured at startup.
DATABASE_URL=sqlite:./data/easyquran.db?mode=rwc

# ── Object storage (S3-compatible). Fail-closed: the four below MUST be set. ─
# Any S3-compatible store (Cloudflare R2, Garage, MinIO, AWS S3, …).
S3_REGION=auto
S3_ACCOUNT_ID=local
S3_BUCKET=easyquran-assets
S3_ACCESS_KEY=devkey
S3_SECRET_KEY=devsecret
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000

# ── Mail ────────────────────────────────────────────────────────────────────
# `smtp` builds the transport lazily (no connection at boot).
MAIL_PROVIDER=smtp
MAIL_FROM_ADDRESS=no-reply@easyquran.local
MAIL_FROM_NAME=EasyQuran
# Required at boot when MAIL_PROVIDER=smtp:
SMTP_HOST=127.0.0.1
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ── Telemetry ───────────────────────────────────────────────────────────────
OTEL_SDK_DISABLED=true

# ── Web (client-visible; PUBLIC_* vars ship to the browser) ─────────────────
# PUBLIC_ENV is set by the `web-dev` recipe. Firebase config is hardcoded in
# web/src/lib/firebase/index.ts — nothing Firebase-related lives here.
# Leave PUBLIC_API_BASE_URL empty in dev: the client falls back to the same-origin
# `/api`, which web/vite.config.ts proxies to 127.0.0.1:8888 with the `/api` prefix
# stripped — the same shape Traefik serves in production.
PUBLIC_API_BASE_URL=
# Vite dev-server port. Adds http://localhost:5173 + http://127.0.0.1:5173 to the
# non-prod CORS/origin allowlist (utils::cors::dev_default_origins), which the
# proxied auth calls need — they carry the browser's 5173 Origin header.
CONSUMER_PORT=5173
OWNER_SOURCE_URL=
# Quran API base used by the browser + SSR. Port MUST equal PORT above.
PUBLIC_QURAN_API_BASE=http://127.0.0.1:8888/quran
INTERNAL_QURAN_API_BASE=

# ── Cloudflare R2 — for `just upload-sqlite` (upload.ts) ────────────────────
# Get these from: Cloudflare dashboard → R2 → Manage API Tokens → Create token
# (Object Read & Write, scoped to the easyquran bucket). Secret key shows once.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
